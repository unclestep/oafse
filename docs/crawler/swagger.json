{
    "produces": [
        "application/json"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Seeds sites for the crawler to start from.",
        "title": "oafse Crawl Control API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:14443",
    "basePath": "/",
    "paths": {
        "/crawl": {
            "post": {
                "description": "Adds url to the crawl queue so the crawler starts discovering pages from it. reindex=true wipes the entire shared crawl cache first - it is not scoped to just this url's site.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "crawl"
                ],
                "summary": "Seed a crawl",
                "parameters": [
                    {
                        "type": "string",
                        "example": "https://books.toscrape.com",
                        "description": "Site URL to start crawling from",
                        "name": "url",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "boolean",
                        "example": false,
                        "description": "Wipe the entire crawl cache before seeding",
                        "name": "reindex",
                        "in": "query"
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/json.CrawlResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/json.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/json.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/search": {
            "get": {
                "description": "Embeds the query via SBERT and returns the most similar pages ranked by dot product.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "search"
                ],
                "summary": "Semantic search",
                "parameters": [
                    {
                        "type": "string",
                        "example": "machine learning",
                        "description": "Search query",
                        "name": "q",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "example": 10,
                        "description": "Max results (default 10)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/json.SearchResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/json.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/json.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "json.CrawlResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "json.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "json.Page": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "json.SearchResponse": {
            "type": "object",
            "properties": {
                "pages": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/json.Page"
                    }
                }
            }
        }
    }
}